# Flight online ticket booking system - backend environment variables

NODE_ENV=development
PORT=3000

# SQLite database file path
DB_STORAGE=./data/flight_system.sqlite
DB_LOGGING=false

# Session secret (use strong random string in production)
SESSION_SECRET=flight-system-secret-key-2026
SESSION_COOKIE_NAME=flight_session
SESSION_MAX_AGE=86400000

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173
